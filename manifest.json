{
    "name": "Markdown Editor Plus",
    "short_name": "Markdown+",
    "description": "A better Markdown file editor for Windows.",

    "id": "./",
    "start_url": "./",
    "display": "standalone",

    "background_color": "#1e1e1e",
    "theme_color": "#1e1e1e",

    "icons": [
        {
            "src": "icons/icon_1.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/icon_1.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],

    "file_handlers": [
        {
            "action": "./editor.html",
            "accept": {
                "text/markdown": [
                    ".md",
                    ".markdown"
                ]
            }
        }
    ]
}